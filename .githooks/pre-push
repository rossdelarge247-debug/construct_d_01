#!/usr/bin/env bash
# .githooks/pre-push — gate push on preflight verdict.
#
# Enable in a fresh clone: git config core.hooksPath .githooks
# Skip one push: git push --no-verify
# block / parse-failed gate the push; request-changes is informational.

set -euo pipefail
exec "$(git rev-parse --show-toplevel)/scripts/preflight-review.sh"
