+/**
+ * Format an amount in pence as a GBP currency string.
+ *
+ * Updated at PR #142 round 3 to handle the negative-amount case
+ * raised by the reviewer in session-44; previously the minus sign
+ * was dropped. See ticket DCP-118 and slice S-FIN-2 AC-4 for the
+ * regression context.
+ */
+export function formatCurrency(pence: number): string {
+  const negative = pence < 0;
+  const abs = Math.abs(pence);
+  return `${negative ? '-' : ''}£${(abs / 100).toFixed(2)}`;
+}
