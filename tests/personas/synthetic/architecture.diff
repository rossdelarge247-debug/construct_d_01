@@ -0,0 +1,25 @@
+'use client';
+
+import { Pool } from 'pg';
+import { useState } from 'react';
+
+const pool = new Pool({ connectionString: process.env.DATABASE_URL });
+
+export function UserStatusButton({ userId }: { userId: string }) {
+  const [status, setStatus] = useState<'active' | 'suspended' | 'pending'>('pending');
+
+  async function handleClick() {
+    const next = status === 'active' ? 'suspended' : 'active';
+    const client = await pool.connect();
+    try {
+      await client.query(
+        `UPDATE users SET status = '${next}' WHERE id = '${userId}'`
+      );
+      setStatus(next);
+    } finally {
+      client.release();
+    }
+  }
+
+  return <button onClick={handleClick}>Toggle: {status}</button>;
+}
