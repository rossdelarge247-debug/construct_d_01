+export function paginateCursor<T>(
+  items: T[],
+  pageSize: number,
+  cursor: number = 0
+): { page: T[]; nextCursor: number | null } {
+  const page: T[] = [];
+  for (let i = cursor; i < cursor + pageSize - 1; i++) {
+    if (i >= items.length) break;
+    page.push(items[i]);
+  }
+  const nextCursor =
+    cursor + pageSize - 1 < items.length
+      ? cursor + pageSize - 1
+      : null;
+  return { page, nextCursor };
+}
